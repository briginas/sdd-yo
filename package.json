{
  "name": "sdd-yo",
  "version": "0.4.0",
  "description": "Repository-native specification governance with a deterministic CLI and optional Agent Skill.",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briginas/sdd-yo.git"
  },
  "bugs": {
    "url": "https://github.com/briginas/sdd-yo/issues"
  },
  "homepage": "https://github.com/briginas/sdd-yo#readme",
  "keywords": [
    "specification",
    "governance",
    "cli",
    "sdd",
    "agent-skill"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/v1/*.schema.json": "./contracts/v1/schemas/*.schema.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "sdd": "./dist/bin/sdd.js"
  },
  "files": [
    "dist",
    "contracts/v1/schemas",
    "skills/sdd-yo"
  ],
  "bundleDependencies": [
    "ajv",
    "ajv-formats",
    "remark-frontmatter",
    "remark-gfm",
    "remark-parse",
    "saxes",
    "unified",
    "yaml"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "benchmark:performance": "node scripts/performance-benchmark.ts",
    "build": "npm run check:schemas && npm run clean:build && tsc -p tsconfig.build.json",
    "check:schemas": "node scripts/generate-schema-types.ts --check",
    "clean:build": "node -e \"import('node:fs/promises').then(({ rm }) => rm('dist', { recursive: true, force: true }))\"",
    "conformance:cross-platform": "node scripts/cross-platform-conformance.ts",
    "format:check": "prettier --check \"scripts/generate-schema-types.ts\" \"scripts/performance-benchmark.ts\" \"scripts/cross-platform-conformance.ts\" \"src/**/*.ts\" \"test/**/*.ts\" \"skills/**/*.md\" \"skills/**/*.yaml\" \"evals/**/*.md\" \"evals/**/*.json\" \"evals/**/*.mjs\" \"evals/skill/scripts/fake-sdd-cli\" \"docs/enforced-governed-scope.md\" \"docs/performance-benchmarks.md\" \"plans/**/*.md\" \".github/**/*.yml\" \"*.md\" \"*.json\"",
    "generate:schemas": "node scripts/generate-schema-types.ts --write",
    "test": "node --test test/*.test.ts",
    "test:package": "node --test test/package-smoke.ts",
    "typecheck": "tsc --noEmit",
    "verify:contracts": "node scripts/verify-contracts.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "saxes": "6.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  }
}
