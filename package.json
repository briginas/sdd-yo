{
  "name": "sdd-yo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/v1/*.schema.json": "./contracts/v1/schemas/*.schema.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "sdd": "./dist/bin/sdd.js"
  },
  "files": [
    "dist",
    "contracts/v1/schemas"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "npm run check:schemas && npm run clean:build && tsc -p tsconfig.build.json",
    "check:schemas": "node scripts/generate-schema-types.ts --check",
    "clean:build": "node -e \"import('node:fs/promises').then(({ rm }) => rm('dist', { recursive: true, force: true }))\"",
    "format:check": "prettier --check \"scripts/generate-schema-types.ts\" \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\" \"*.json\"",
    "generate:schemas": "node scripts/generate-schema-types.ts --write",
    "test": "node --test test/*.test.ts",
    "test:package": "node --test test/package-smoke.ts",
    "typecheck": "tsc --noEmit",
    "verify:stage-0": "node scripts/verify-stage-0.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "saxes": "6.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  }
}
