#!/usr/bin/env node

import { spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import { lstatSync, readFileSync, readdirSync, realpathSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, isAbsolute, join, relative, resolve, sep } from "node:path";
import { fileURLToPath } from "node:url";

const TECHNICAL_FAILURE = 3;
const SUPPORTED_OPERATIONS = new Set([
  "approval.record",
  "init",
  "id",
  "validate",
  "inspect",
  "trace",
  "proposal.validate",
  "proposal.materialize",
  "proposal.prepare",
  "proposal.apply",
  "tests.discover",
  "findings.validate",
  "merge.check",
]);
const AUTHORING_ID_KINDS = new Map([
  ["capability", "CAP"],
  ["requirement", "REQ"],
  ["concept", "CON"],
]);
const scriptDirectory = dirname(fileURLToPath(import.meta.url));
const installedRepositoryRoot = resolve(scriptDirectory, "../../../..");
const installedSkillRoot = resolve(scriptDirectory, "..");
const installationManifestPath = resolve(scriptDirectory, "../installation.json");

function fail(message) {
  process.stderr.write(`sdd-yo: ${message}\n`);
  process.exit(TECHNICAL_FAILURE);
}

function optionValue(arguments_, option) {
  const index = arguments_.indexOf(option);
  if (index === -1) return undefined;
  const value = arguments_[index + 1];
  if (value === undefined || value.startsWith("--")) fail(`${option} requires a value.`);
  return value;
}

function isRecord(value) {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

function isFingerprint(value) {
  return typeof value === "string" && /^sha256:[0-9a-f]{64}$/u.test(value);
}

function isObjectId(value) {
  return typeof value === "string" && /^(?:CAP|REQ|CON)-[0-9A-F]{8}$/u.test(value);
}

function isRequirementId(value) {
  return typeof value === "string" && /^REQ-[0-9A-F]{8}$/u.test(value);
}

function isCapabilityId(value) {
  return typeof value === "string" && /^CAP-[0-9A-F]{8}$/u.test(value);
}

function verifyApprovalRecordResult(result, projectId) {
  return (
    hasExactKeys(result, ["evidence_path", "decision", "mode", "subject"]) &&
    isProjectPath(result.evidence_path) &&
    ["approved", "rejected"].includes(result.decision) &&
    ["spec-code", "spec", "code"].includes(result.mode) &&
    result.subject.mode === result.mode &&
    verifyProposalPackage(result.subject, projectId) === undefined
  );
}

function isFindingId(value) {
  return typeof value === "string" && /^FND-[0-9A-F]{12}$/u.test(value);
}

function isSortedUniqueStrings(values, predicate = () => true) {
  return (
    Array.isArray(values) &&
    values.every((value) => typeof value === "string" && predicate(value)) &&
    values.every((value, index) => index === 0 || values[index - 1] < value)
  );
}

function hasExactKeys(value, required, optional = []) {
  if (!isRecord(value)) return false;
  const allowed = new Set([...required, ...optional]);
  return required.every((key) => key in value) && Object.keys(value).every((key) => allowed.has(key));
}

function isContained(root, path) {
  const fromRoot = relative(root, path);
  return fromRoot === "" || (!isAbsolute(fromRoot) && fromRoot !== ".." && !fromRoot.startsWith(`..${sep}`));
}

function isFileInventory(value) {
  return (
    Array.isArray(value) &&
    value.length > 0 &&
    value.every(
      (entry, index) =>
        hasExactKeys(entry, ["path", "sha256"]) &&
        isProjectPath(entry.path) &&
        isFingerprint(entry.sha256) &&
        (index === 0 || value[index - 1].path < entry.path),
    )
  );
}

function verifyOwnedInventory(root, expected, extra = []) {
  let rootReal;
  try {
    const rootMetadata = lstatSync(root);
    if (!rootMetadata.isDirectory() || rootMetadata.isSymbolicLink()) fail("an installed ownership root is unsafe.");
    rootReal = realpathSync(root);
  } catch {
    fail("an installed ownership root is missing or unavailable.");
  }
  const actual = [];
  const actualDirectories = [];
  for (const entry of readdirSync(rootReal, { recursive: true, withFileTypes: true })) {
    if (entry.isSymbolicLink() || (!entry.isDirectory() && !entry.isFile()))
      fail("an installed ownership inventory contains an unsafe entry.");
    const absolute = join(entry.parentPath, entry.name);
    const path = relative(rootReal, absolute).split(sep).join("/");
    if (entry.isDirectory()) {
      actualDirectories.push(path);
      continue;
    }
    actual.push({ path, sha256: `sha256:${createHash("sha256").update(readFileSync(absolute)).digest("hex")}` });
  }
  actual.sort((left, right) => (left.path < right.path ? -1 : left.path > right.path ? 1 : 0));
  const declared = [...expected, ...extra].sort((left, right) =>
    left.path < right.path ? -1 : left.path > right.path ? 1 : 0,
  );
  const expectedDirectories = new Set();
  for (const entry of declared) {
    const segments = entry.path.split("/");
    for (let index = 1; index < segments.length; index += 1)
      expectedDirectories.add(segments.slice(0, index).join("/"));
  }
  actualDirectories.sort();
  if (
    JSON.stringify(actual) !== JSON.stringify(declared) ||
    JSON.stringify(actualDirectories) !== JSON.stringify([...expectedDirectories].sort())
  )
    fail("an installed ownership inventory is stale or modified.");
}

function readInstallationBinding(required) {
  let value;
  try {
    value = JSON.parse(readFileSync(installationManifestPath, "utf8"));
  } catch (error) {
    if (!required && error?.code === "ENOENT") return undefined;
    fail("the repository-scoped Skill installation binding is missing or malformed.");
  }
  if (value?.artifact_type === "sdd_yo_user_skill_installation") {
    if (
      !hasExactKeys(value, [
        "schema_version",
        "artifact_type",
        "scope",
        "package",
        "cli",
        "json_schema",
        "skill",
        "package_fingerprint",
        "package_files",
        "skill_files",
      ]) ||
      value.schema_version !== "1.0" ||
      value.scope !== "user" ||
      !hasExactKeys(value.package, ["name", "version"]) ||
      value.package.name !== "sdd-yo" ||
      typeof value.package.version !== "string" ||
      !hasExactKeys(value.cli, ["name", "version", "path"]) ||
      value.cli.name !== "sdd" ||
      value.cli.version !== value.package.version ||
      !isAbsolute(value.cli.path) ||
      !hasExactKeys(value.json_schema, ["version", "compatible_major"]) ||
      value.json_schema.compatible_major !== 1 ||
      !hasExactKeys(value.skill, ["name", "protocol_version", "compatible_major", "payload_fingerprint"]) ||
      value.skill.name !== "sdd-yo" ||
      value.skill.compatible_major !== 1 ||
      !isFingerprint(value.skill.payload_fingerprint) ||
      !isFingerprint(value.package_fingerprint) ||
      !isFileInventory(value.package_files) ||
      !isFileInventory(value.skill_files) ||
      value.package_fingerprint !==
        `sha256:${createHash("sha256").update(JSON.stringify(value.package_files)).digest("hex")}` ||
      value.skill.payload_fingerprint !==
        `sha256:${createHash("sha256").update(JSON.stringify(value.skill_files)).digest("hex")}`
    )
      fail("the user-scoped Skill installation binding is incompatible.");
    const canonicalHome = realpathSync(homedir());
    const expectedSkillRoot = join(canonicalHome, ".agents", "skills", "sdd-yo");
    const expectedPackageRoot = join(
      canonicalHome,
      "Library",
      "Application Support",
      "sdd-yo",
      "cli",
      value.package.version,
    );
    if (realpathSync(installedSkillRoot) !== realpathSync(expectedSkillRoot))
      fail("the user-scoped Skill installation was moved from its canonical path.");
    if (value.cli.path !== join(expectedPackageRoot, "dist", "bin", "sdd.js"))
      fail("the user-scoped private CLI path is not canonical.");
    const bindingBytes = readFileSync(installationManifestPath);
    verifyOwnedInventory(installedSkillRoot, value.skill_files, [
      {
        path: "installation.json",
        sha256: `sha256:${createHash("sha256").update(bindingBytes).digest("hex")}`,
      },
    ]);
    verifyOwnedInventory(expectedPackageRoot, value.package_files);
    return value;
  }
  if (
    !hasExactKeys(value, ["schema_version", "artifact_type", "package", "cli", "json_schema", "skill"]) ||
    value.schema_version !== "1.0" ||
    value.artifact_type !== "sdd_yo_skill_installation" ||
    !hasExactKeys(value.package, ["name", "version"]) ||
    value.package.name !== "sdd-yo" ||
    typeof value.package.version !== "string" ||
    value.package.version.length === 0 ||
    !hasExactKeys(value.cli, ["name", "version", "path"]) ||
    value.cli.name !== "sdd" ||
    value.cli.version !== value.package.version ||
    !isProjectPath(value.cli.path) ||
    !hasExactKeys(value.json_schema, ["version", "compatible_major"]) ||
    value.json_schema.compatible_major !== 1 ||
    !hasExactKeys(value.skill, ["name", "protocol_version", "compatible_major", "payload_fingerprint"]) ||
    value.skill.name !== "sdd-yo" ||
    value.skill.compatible_major !== 1 ||
    !isFingerprint(value.skill.payload_fingerprint)
  )
    fail("the repository-scoped Skill installation binding is incompatible.");
  return value;
}

function verifyCompatibilityIdentity(value, binding) {
  if (
    !hasExactKeys(value, ["schema_version", "command", "project_id", "status", "result", "diagnostics"]) ||
    value.schema_version !== "1.0" ||
    value.command !== "version" ||
    value.project_id !== null ||
    value.status !== "ok" ||
    !Array.isArray(value.diagnostics) ||
    value.diagnostics.length !== 0 ||
    !hasExactKeys(value.result, ["package", "cli", "json_schema", "skill"]) ||
    !hasExactKeys(value.result.package, ["name", "version"]) ||
    value.result.package.name !== "sdd-yo" ||
    !hasExactKeys(value.result.cli, ["name", "version"]) ||
    value.result.cli.name !== "sdd" ||
    value.result.cli.version !== value.result.package.version ||
    !hasExactKeys(value.result.json_schema, ["version", "compatible_major"]) ||
    value.result.json_schema.compatible_major !== 1 ||
    !hasExactKeys(value.result.skill, ["name", "protocol_version", "compatible_major"]) ||
    value.result.skill.name !== "sdd-yo" ||
    value.result.skill.compatible_major !== 1 ||
    (binding !== undefined &&
      (value.result.package.name !== binding.package.name ||
        value.result.package.version !== binding.package.version ||
        value.result.cli.name !== binding.cli.name ||
        value.result.cli.version !== binding.cli.version ||
        value.result.json_schema.version !== binding.json_schema.version ||
        value.result.json_schema.compatible_major !== binding.json_schema.compatible_major ||
        value.result.skill.name !== binding.skill.name ||
        value.result.skill.protocol_version !== binding.skill.protocol_version ||
        value.result.skill.compatible_major !== binding.skill.compatible_major))
  )
    fail("the selected sdd CLI compatibility identity is missing, malformed, or incompatible.");
}

function isSemanticCandidate(value) {
  return (
    hasExactKeys(value, ["objects", "reason"]) &&
    isSortedUniqueStrings(value.objects, isObjectId) &&
    value.objects.length > 0 &&
    typeof value.reason === "string" &&
    value.reason.length > 0
  );
}

function isProjectPath(value) {
  return (
    typeof value === "string" &&
    value.length > 0 &&
    !value.includes("\\") &&
    !isAbsolute(value) &&
    value.split("/").every((segment) => segment !== "" && segment !== "." && segment !== "..")
  );
}

function requireOption(arguments_, option, operation) {
  const value = optionValue(arguments_, option);
  if (value === undefined) fail(`${operation} requires ${option}.`);
  return value;
}

function selectedProjectId(arguments_, command) {
  let configPath;
  if (command === "init") {
    configPath = resolve(process.cwd(), requireOption(arguments_, "--root", "init"), ".sdd", "config.yaml");
  } else {
    const explicitConfig = optionValue(arguments_, "--config");
    if (explicitConfig !== undefined) configPath = resolve(process.cwd(), explicitConfig);
    else {
      let current = resolve(process.cwd(), requireOption(arguments_, "--cwd", command));
      for (;;) {
        const candidate = join(current, ".sdd", "config.yaml");
        try {
          if (lstatSync(candidate).isFile()) {
            configPath = candidate;
            break;
          }
        } catch {
          // Continue to the parent until the selected filesystem root is exhausted.
        }
        const parent = dirname(current);
        if (parent === current) fail("the explicit user-mode project selector has no SDD Project configuration.");
        current = parent;
      }
    }
  }
  let config;
  try {
    config = readFileSync(configPath, "utf8");
  } catch {
    fail("the explicit user-mode project configuration is unavailable.");
  }
  const matches = [
    ...config.matchAll(/^project_id:\s*(?:"(SDD-[0-9A-F]{8})"|'(SDD-[0-9A-F]{8})'|(SDD-[0-9A-F]{8}))\s*(?:#.*)?$/gmu),
  ];
  if (matches.length !== 1) fail("the explicit user-mode project identity is missing or ambiguous.");
  return matches[0][1] ?? matches[0][2] ?? matches[0][3];
}

function verifyProposalPackage(result, projectId) {
  if (
    !isRecord(result) ||
    result.schema_version !== "1.0" ||
    result.artifact_type !== "proposal_package" ||
    result.project_id !== projectId ||
    !["spec-code", "spec", "code"].includes(result.mode) ||
    !isRecord(result.base) ||
    typeof result.base.git_ref !== "string" ||
    result.base.git_ref.length === 0 ||
    !isFingerprint(result.base.tree_fingerprint) ||
    !isRecord(result.candidate) ||
    !["base", "directory", "manifest"].includes(result.candidate.source) ||
    !isFingerprint(result.candidate.tree_fingerprint) ||
    !isRecord(result.object_delta) ||
    !isFingerprint(result.object_delta.semantic_fingerprint) ||
    !isFingerprint(result.object_delta.structural_fingerprint) ||
    !isSortedUniqueStrings(result.object_delta.added, isObjectId) ||
    !isSortedUniqueStrings(result.object_delta.modified, isObjectId) ||
    !isSortedUniqueStrings(result.object_delta.deleted, isObjectId) ||
    !Array.isArray(result.code_targets) ||
    result.code_targets.some(
      (target) =>
        !hasExactKeys(target, ["requirement_id", "semantic_fingerprint", "structural_fingerprint"]) ||
        typeof target.requirement_id !== "string" ||
        !/^REQ-[0-9A-F]{8}$/u.test(target.requirement_id) ||
        !isFingerprint(target.semantic_fingerprint) ||
        !isFingerprint(target.structural_fingerprint),
    ) ||
    !isRecord(result.affected_scope) ||
    !isFingerprint(result.affected_scope.fingerprint) ||
    !isSortedUniqueStrings(result.affected_scope.requirements, (value) => /^REQ-[0-9A-F]{8}$/u.test(value)) ||
    !isSortedUniqueStrings(result.affected_scope.capabilities, (value) => /^CAP-[0-9A-F]{8}$/u.test(value)) ||
    !Array.isArray(result.diagnostics) ||
    !Array.isArray(result.semantic_candidates) ||
    result.semantic_candidates.some((candidate) => !isSemanticCandidate(candidate))
  )
    fail("the sdd CLI returned an invalid ProposalPackage result.");
}

function verifyConflictReport(result, projectId) {
  return (
    isRecord(result) &&
    result.schema_version === "1.0" &&
    result.artifact_type === "conflict_report" &&
    result.project_id === projectId &&
    typeof result.integration_ref === "string" &&
    result.integration_ref.length > 0 &&
    typeof result.branch_head === "string" &&
    result.branch_head.length > 0 &&
    typeof result.merge_base === "string" &&
    result.merge_base.length > 0 &&
    isFingerprint(result.config_fingerprint) &&
    Array.isArray(result.mechanical_conflicts) &&
    result.mechanical_conflicts.every(
      (conflict) =>
        hasExactKeys(conflict, ["path", "kind"], ["object_id"]) &&
        isProjectPath(conflict.path) &&
        ["add_add", "modify_modify", "modify_delete", "delete_modify", "id_reuse"].includes(conflict.kind) &&
        (conflict.object_id === undefined || isObjectId(conflict.object_id)),
    ) &&
    Array.isArray(result.semantic_candidates) &&
    result.semantic_candidates.every(isSemanticCandidate) &&
    isFingerprint(result.input_fingerprint)
  );
}

function verifySpecPatch(result, projectId) {
  const operationsValid =
    Array.isArray(result?.operations) &&
    result.operations.every((operation) => {
      if (!isRecord(operation) || !isProjectPath(operation.path)) return false;
      if (operation.operation === "create" || operation.operation === "replace") {
        const required =
          operation.operation === "create"
            ? ["operation", "path", "after_sha256", "content_utf8"]
            : ["operation", "path", "before_sha256", "after_sha256", "content_utf8"];
        if (
          !hasExactKeys(operation, required) ||
          typeof operation.content_utf8 !== "string" ||
          !isFingerprint(operation.after_sha256) ||
          (operation.operation === "replace" && !isFingerprint(operation.before_sha256))
        )
          return false;
        const actual = `sha256:${createHash("sha256").update(operation.content_utf8, "utf8").digest("hex")}`;
        return actual === operation.after_sha256;
      }
      return (
        operation.operation === "delete" &&
        hasExactKeys(operation, ["operation", "path", "before_sha256"]) &&
        isFingerprint(operation.before_sha256)
      );
    });
  return (
    isRecord(result) &&
    result.schema_version === "1.0" &&
    result.artifact_type === "spec_patch" &&
    result.project_id === projectId &&
    isFingerprint(result.base_tree_fingerprint) &&
    isFingerprint(result.result_tree_fingerprint) &&
    operationsValid &&
    result.operations.every((operation, index) => index === 0 || result.operations[index - 1].path < operation.path)
  );
}

function verifyTestIndex(result, projectId) {
  const adapterEntries = isRecord(result?.subject?.adapter_fingerprints)
    ? Object.entries(result.subject.adapter_fingerprints)
    : [];
  return (
    hasExactKeys(
      result,
      ["schema_version", "artifact_type", "project_id", "subject", "tests"],
      ["created_at", "producer"],
    ) &&
    result.schema_version === "1.0" &&
    result.artifact_type === "test_index" &&
    result.project_id === projectId &&
    hasExactKeys(result.subject, ["head_ref", "config_fingerprint", "adapter_fingerprints"]) &&
    typeof result.subject.head_ref === "string" &&
    result.subject.head_ref.length > 0 &&
    isFingerprint(result.subject.config_fingerprint) &&
    adapterEntries.length > 0 &&
    adapterEntries.every(
      ([id, fingerprint], index) =>
        /^[a-z][a-z0-9-]{0,31}$/u.test(id) &&
        isFingerprint(fingerprint) &&
        (index === 0 || adapterEntries[index - 1][0] < id),
    ) &&
    Array.isArray(result.tests) &&
    result.tests.every(
      (test, index) =>
        hasExactKeys(test, ["test_ref", "adapter_id", "local_id", "full_name", "requirement_ids"], ["source"]) &&
        typeof test.test_ref === "string" &&
        test.test_ref.length > 0 &&
        typeof test.adapter_id === "string" &&
        Object.hasOwn(result.subject.adapter_fingerprints, test.adapter_id) &&
        typeof test.local_id === "string" &&
        test.local_id.length > 0 &&
        typeof test.full_name === "string" &&
        test.full_name.length > 0 &&
        isSortedUniqueStrings(test.requirement_ids, isRequirementId) &&
        (index === 0 || result.tests[index - 1].test_ref < test.test_ref) &&
        (test.source === undefined ||
          (hasExactKeys(test.source, ["path"], ["line", "column"]) &&
            isProjectPath(test.source.path) &&
            (test.source.line === undefined || (Number.isInteger(test.source.line) && test.source.line >= 1)) &&
            (test.source.column === undefined || (Number.isInteger(test.source.column) && test.source.column >= 1)))),
    )
  );
}

function isFindingSummary(value) {
  return (
    hasExactKeys(value, ["finding_id", "state"]) &&
    isFindingId(value.finding_id) &&
    ["open", "resolved", "stale", "contradictory"].includes(value.state)
  );
}

function verifyFindingAssessment(result) {
  return (
    hasExactKeys(result, ["findings", "human_review_state", "issues", "semantic_completeness_claimed"]) &&
    Array.isArray(result.findings) &&
    result.findings.every(
      (finding, index) =>
        isFindingSummary(finding) && (index === 0 || result.findings[index - 1].finding_id < finding.finding_id),
    ) &&
    ["not_required", "current", "missing", "stale", "contradictory"].includes(result.human_review_state) &&
    Array.isArray(result.issues) &&
    result.issues.every(
      (issue) =>
        hasExactKeys(issue, ["code", "disposition"], ["finding_id", "issuer"]) &&
        typeof issue.code === "string" &&
        /^SDD_[A-Z0-9_]+$/u.test(issue.code) &&
        ["BLOCKED", "REVIEW_REQUIRED"].includes(issue.disposition) &&
        (issue.finding_id === undefined || isFindingId(issue.finding_id)) &&
        (issue.issuer === undefined || (typeof issue.issuer === "string" && issue.issuer.length > 0)),
    ) &&
    result.semantic_completeness_claimed === false
  );
}

function isCheckSummary(value, applicable) {
  return (
    hasExactKeys(value, ["status", "satisfied", "unsatisfied"]) &&
    ["PASS", "REVIEW_REQUIRED", "BLOCKED", "NOT_APPLICABLE"].includes(value.status) &&
    Number.isInteger(value.satisfied) &&
    value.satisfied >= 0 &&
    Number.isInteger(value.unsatisfied) &&
    value.unsatisfied >= 0 &&
    (applicable
      ? value.status !== "NOT_APPLICABLE"
      : value.status === "NOT_APPLICABLE" && value.satisfied === 0 && value.unsatisfied === 0)
  );
}

function verifyMergeReport(result, projectId, responseStatus) {
  const applicable =
    Array.isArray(result?.affected_scope?.requirements) &&
    Array.isArray(result?.affected_scope?.capabilities) &&
    (result.affected_scope.requirements.length > 0 || result.affected_scope.capabilities.length > 0);
  const expectedEnvelopeStatus =
    result?.status === "PASS" ? "ok" : result?.status === "BLOCKED" ? "blocked" : "review_required";
  const deltaValid =
    result?.mode === "code"
      ? hasExactKeys(result.deltas_or_code_targets, ["code_targets"]) &&
        Array.isArray(result.deltas_or_code_targets.code_targets) &&
        result.deltas_or_code_targets.code_targets.length > 0 &&
        result.deltas_or_code_targets.code_targets.every(
          (target) =>
            hasExactKeys(target, ["requirement_id", "semantic_fingerprint", "structural_fingerprint"]) &&
            isRequirementId(target.requirement_id) &&
            isFingerprint(target.semantic_fingerprint) &&
            isFingerprint(target.structural_fingerprint),
        )
      : hasExactKeys(result?.deltas_or_code_targets, ["approved_delta"]) &&
        hasExactKeys(result.deltas_or_code_targets.approved_delta, ["semantic", "structural"]) &&
        isFingerprint(result.deltas_or_code_targets.approved_delta.semantic) &&
        isFingerprint(result.deltas_or_code_targets.approved_delta.structural);
  return (
    hasExactKeys(result, [
      "schema_version",
      "artifact_type",
      "project_id",
      "integration_ref",
      "branch_head",
      "merge_base",
      "config_fingerprint",
      "mode",
      "deltas_or_code_targets",
      "affected_scope",
      "test_summary",
      "qa_summary",
      "findings_and_evidence",
      "adoption",
      "diagnostics",
      "status",
      "input_manifest",
    ]) &&
    result.schema_version === "1.0" &&
    result.artifact_type === "merge_report" &&
    result.project_id === projectId &&
    [result.integration_ref, result.branch_head, result.merge_base].every(
      (ref) => typeof ref === "string" && ref.length > 0,
    ) &&
    isFingerprint(result.config_fingerprint) &&
    ["spec-code", "spec", "code"].includes(result.mode) &&
    deltaValid &&
    hasExactKeys(result.affected_scope, ["fingerprint", "requirements", "capabilities"]) &&
    isFingerprint(result.affected_scope.fingerprint) &&
    isSortedUniqueStrings(result.affected_scope.requirements, isRequirementId) &&
    isSortedUniqueStrings(result.affected_scope.capabilities, isCapabilityId) &&
    isCheckSummary(result.test_summary, applicable) &&
    isCheckSummary(result.qa_summary, applicable) &&
    hasExactKeys(result.findings_and_evidence, ["findings", "evidence_status"]) &&
    Array.isArray(result.findings_and_evidence.findings) &&
    result.findings_and_evidence.findings.every(isFindingSummary) &&
    ["current", "missing", "stale", "negative", "contradictory"].includes(
      result.findings_and_evidence.evidence_status,
    ) &&
    hasExactKeys(result.adoption, ["mode", "project_scope_fingerprint"]) &&
    ["incremental", "complete"].includes(result.adoption.mode) &&
    isFingerprint(result.adoption.project_scope_fingerprint) &&
    Array.isArray(result.diagnostics) &&
    ["PASS", "REVIEW_REQUIRED", "BLOCKED"].includes(result.status) &&
    expectedEnvelopeStatus === responseStatus &&
    Array.isArray(result.input_manifest) &&
    result.input_manifest.length > 0 &&
    result.input_manifest.every(
      (entry) =>
        hasExactKeys(entry, ["artifact_type", "fingerprint", "source"]) &&
        typeof entry.artifact_type === "string" &&
        entry.artifact_type.length > 0 &&
        isFingerprint(entry.fingerprint) &&
        (entry.source === "stdin" || isProjectPath(entry.source)),
    )
  );
}

function verifyCreatedPaths(root, createdPaths) {
  const rootPath = resolve(root);
  const seen = new Set();
  for (const projectPath of createdPaths) {
    if (
      typeof projectPath !== "string" ||
      projectPath.length === 0 ||
      projectPath.includes("\\") ||
      isAbsolute(projectPath)
    )
      fail("init returned a non-portable created path.");
    const segments = projectPath.split("/");
    if (segments.some((segment) => segment === "" || segment === "." || segment === ".."))
      fail("init returned an unsafe created path.");
    if (seen.has(projectPath)) fail("init returned a duplicate created path.");
    seen.add(projectPath);

    let current = rootPath;
    for (const segment of segments) {
      current = resolve(current, segment);
      const fromRoot = relative(rootPath, current);
      if (fromRoot === ".." || fromRoot.startsWith(`..${process.platform === "win32" ? "\\" : "/"}`))
        fail("init returned a path outside the selected root.");
      let metadata;
      try {
        metadata = lstatSync(current);
      } catch {
        fail(`init reported a path that does not exist: ${projectPath}.`);
      }
      if (metadata.isSymbolicLink()) fail(`init reported a path traversing a symbolic link: ${projectPath}.`);
    }
    const metadata = lstatSync(current);
    if (!metadata.isFile() && !metadata.isDirectory())
      fail(`init reported a special filesystem entry: ${projectPath}.`);
  }
}

const separator = process.argv.indexOf("--", 2);
if (separator === -1) fail("usage: check-cli-compatibility [--cli <path>] -- <command> <arguments>");

const wrapperArguments = process.argv.slice(2, separator);
const binding = readInstallationBinding(wrapperArguments.length === 0);
let executable;
if (wrapperArguments.length > 0) {
  if (binding?.artifact_type === "sdd_yo_user_skill_installation")
    fail("--cli is unavailable for a user-scoped Skill installation.");
  if (wrapperArguments.length !== 2 || wrapperArguments[0] !== "--cli" || wrapperArguments[1] === undefined)
    fail("only --cli <path> may precede --.");
  if (!isAbsolute(wrapperArguments[1])) fail("--cli requires one explicit absolute executable path.");
  executable = wrapperArguments[1];
} else if (binding.artifact_type === "sdd_yo_user_skill_installation") {
  let resolvedBoundPath;
  try {
    resolvedBoundPath = realpathSync(binding.cli.path);
  } catch {
    fail("the bound private sdd CLI is missing or unavailable.");
  }
  if (resolvedBoundPath !== binding.cli.path) fail("the bound private sdd CLI path is moved or symbolic.");
  executable = resolvedBoundPath;
} else {
  const boundPath = resolve(installedRepositoryRoot, binding.cli.path);
  let resolvedBoundPath;
  try {
    resolvedBoundPath = realpathSync(boundPath);
  } catch {
    fail("the bound sdd CLI is missing or unavailable.");
  }
  if (!isContained(realpathSync(installedRepositoryRoot), resolvedBoundPath))
    fail("the bound sdd CLI path escapes the selected repository.");
  executable = resolvedBoundPath;
}

const commandArguments = process.argv.slice(separator + 1);
const command = commandArguments[0];
const operation = ["approval", "proposal", "tests", "findings", "merge"].includes(command)
  ? `${command}.${commandArguments[1] ?? ""}`
  : command;
if (command === undefined || !SUPPORTED_OPERATIONS.has(operation))
  fail(
    "this skill slice permits only init, id, validate, inspect, trace, approval record, proposal validate/prepare/apply, tests discover, findings validate, or merge check.",
  );
if (commandArguments.includes("--output")) fail("--output is unavailable because JSON must remain on stdout.");
if (commandArguments.includes("--format")) fail("omit --format; the compatibility wrapper always selects JSON.");

let invocationExecutable = executable;
let invocationPrefix = [];
try {
  const firstLine = readFileSync(executable, "utf8").split(/\r?\n/u, 1)[0];
  if (firstLine === "#!/usr/bin/env node") {
    invocationExecutable = process.execPath;
    invocationPrefix = [executable];
  }
} catch {
  // Preserve spawn's stable missing or unavailable CLI diagnostics below.
}

const identityExecution = spawnSync(invocationExecutable, [...invocationPrefix, "--version", "--format", "json"], {
  encoding: "utf8",
  maxBuffer: 1024 * 1024,
  timeout: 120_000,
  windowsHide: true,
});
if (identityExecution.error !== undefined) {
  if (identityExecution.error.code === "ENOENT") fail("the sdd CLI is missing; install nothing and stop.");
  if (identityExecution.error.code === "ETIMEDOUT") fail("the sdd CLI identity check was interrupted.");
  fail(`the sdd CLI identity check could not complete: ${identityExecution.error.message}`);
}
if (identityExecution.signal !== null || identityExecution.status !== 0)
  fail("the sdd CLI identity check did not complete successfully.");
let identity;
try {
  identity = JSON.parse(identityExecution.stdout);
} catch {
  fail("the sdd CLI returned malformed compatibility identity JSON.");
}
verifyCompatibilityIdentity(identity, binding);

const cwd = optionValue(commandArguments, "--cwd");
const config = optionValue(commandArguments, "--config");
if (cwd !== undefined && config !== undefined) fail("--cwd and --config are mutually exclusive.");

if (command === "init") {
  const root = optionValue(commandArguments, "--root");
  const adoption = optionValue(commandArguments, "--adoption");
  if (root === undefined) fail("init requires an explicit --root.");
  if (adoption !== "incremental" && adoption !== "complete")
    fail("init requires --adoption incremental or --adoption complete.");
} else if (cwd === undefined && config === undefined) {
  fail(`${operation} requires an explicit --cwd or --config selector.`);
}

if (operation === "proposal.validate") {
  const bundle = optionValue(commandArguments, "--bundle");
  const packagePath = optionValue(commandArguments, "--package");
  if (bundle !== undefined && packagePath !== undefined) fail("proposal.validate accepts one retained subject input.");
  if (bundle === undefined && packagePath === undefined) {
    const mode = requireOption(commandArguments, "--mode", operation);
    if (!["spec-code", "spec", "code"].includes(mode)) fail("proposal.validate requires a supported --mode.");
    requireOption(commandArguments, "--base", operation);
    requireOption(commandArguments, "--candidate", operation);
  }
}
if (operation === "proposal.materialize") {
  for (const option of ["--mode", "--base", "--bundle"]) requireOption(commandArguments, option, operation);
  const mode = optionValue(commandArguments, "--mode");
  if (!["spec-code", "spec", "code"].includes(mode)) fail("proposal.materialize requires a supported --mode.");
  if (mode === "code") {
    if (optionValue(commandArguments, "--candidate") !== undefined)
      fail("proposal.materialize code mode does not accept --candidate.");
    requireOption(commandArguments, "--code-target", operation);
  } else if (optionValue(commandArguments, "--candidate") === undefined) {
    fail("proposal.materialize specification-changing modes require --candidate.");
  }
}
if (operation === "approval.record") {
  for (const option of ["--issuer", "--actor", "--decision", "--reason", "--evidence"])
    requireOption(commandArguments, option, operation);
  if ((optionValue(commandArguments, "--bundle") === undefined) === (optionValue(commandArguments, "--package") === undefined))
    fail("approval.record requires exactly one retained bundle or code package.");
  const decision = optionValue(commandArguments, "--decision");
  if (decision !== "approved" && decision !== "rejected")
    fail("approval.record requires --decision approved or rejected.");
}
if (operation === "proposal.prepare") {
  requireOption(commandArguments, "--package", operation);
  requireOption(commandArguments, "--candidate", operation);
  requireOption(commandArguments, "--branch-head", operation);
  requireOption(commandArguments, "--integration-ref", operation);
}
if (operation === "proposal.apply") requireOption(commandArguments, "--patch", operation);
if (operation === "tests.discover") requireOption(commandArguments, "--head", operation);
if (operation === "findings.validate") {
  requireOption(commandArguments, "--input-manifest", operation);
  requireOption(commandArguments, "--findings", operation);
}
if (operation === "merge.check") {
  for (const option of [
    "--change",
    "--package",
    "--candidate",
    "--approval",
    "--test-index",
    "--test-evidence",
    "--qa",
  ])
    requireOption(commandArguments, option, operation);
}

let expectedIdCount;
let expectedIdPrefix;
if (command === "id") {
  const kind = commandArguments[1];
  expectedIdPrefix = AUTHORING_ID_KINDS.get(kind);
  if (expectedIdPrefix === undefined) fail("this skill slice generates only capability, requirement, or concept IDs.");
  const countValue = optionValue(commandArguments, "--count");
  expectedIdCount = countValue === undefined ? 1 : Number(countValue);
  if (!Number.isInteger(expectedIdCount) || expectedIdCount < 1 || expectedIdCount > 256)
    fail("id --count must be an integer from 1 through 256.");
}

const execution = spawnSync(invocationExecutable, [...invocationPrefix, ...commandArguments, "--format", "json"], {
  encoding: "utf8",
  maxBuffer: 8 * 1024 * 1024,
  timeout: 120_000,
  windowsHide: true,
});

if (execution.error !== undefined) {
  if (execution.error.code === "ENOENT") fail("the sdd CLI is missing; install nothing and stop.");
  if (execution.error.code === "ETIMEDOUT") fail("the sdd CLI was interrupted after the compatibility timeout.");
  fail(`the sdd CLI could not complete: ${execution.error.message}`);
}
if (execution.signal !== null) fail(`the sdd CLI was interrupted by signal ${execution.signal}.`);
if (execution.status === null || ![0, 1, 2, 3].includes(execution.status))
  fail(`the sdd CLI returned unsupported exit status ${String(execution.status)}.`);

let response;
try {
  response = JSON.parse(execution.stdout);
} catch {
  fail("the sdd CLI returned malformed JSON.");
}

if (!isRecord(response)) fail("the sdd CLI returned a non-object JSON response.");
if (typeof response.schema_version !== "string" || !/^1(?:\.[0-9]+)$/u.test(response.schema_version))
  fail(`the sdd CLI returned incompatible schema version ${JSON.stringify(response.schema_version)}.`);
if (response.command !== operation) fail(`the sdd CLI response command does not match ${operation}.`);
if (response.project_id !== null && typeof response.project_id !== "string")
  fail("the sdd CLI returned an invalid project_id.");
if (!["ok", "blocked", "review_required", "error"].includes(response.status))
  fail("the sdd CLI returned an invalid status.");
if (!("result" in response) || !Array.isArray(response.diagnostics))
  fail("the sdd CLI response is missing result or diagnostics.");

const expectedStatus = new Map([
  [0, "ok"],
  [1, "blocked"],
  [2, "review_required"],
  [3, "error"],
]);
if (response.status !== expectedStatus.get(execution.status))
  fail("the sdd CLI status does not match its exit status.");
if (
  binding?.artifact_type === "sdd_yo_user_skill_installation" &&
  response.status !== "error" &&
  response.project_id !== selectedProjectId(commandArguments, command)
)
  fail("the sdd CLI result does not match the explicitly selected user-mode project.");

if (command === "init" && response.status === "ok") {
  if (
    typeof response.project_id !== "string" ||
    !/^SDD-[0-9A-F]{8}$/u.test(response.project_id) ||
    !isRecord(response.result) ||
    !Array.isArray(response.result.created_paths)
  )
    fail("the sdd CLI returned an invalid initialization result.");
  verifyCreatedPaths(optionValue(commandArguments, "--root"), response.result.created_paths);
}
if (command === "validate" && response.status === "ok") {
  if (!isRecord(response.result) || response.result.valid !== true || !Array.isArray(response.result.fingerprints))
    fail("the sdd CLI returned an invalid validation result.");
}
if (command === "id" && response.status === "ok") {
  if (
    typeof response.project_id !== "string" ||
    !/^SDD-[0-9A-F]{8}$/u.test(response.project_id) ||
    !isRecord(response.result) ||
    !Array.isArray(response.result.candidates) ||
    response.result.candidates.length !== expectedIdCount ||
    response.result.candidates.some(
      (candidate) =>
        typeof candidate !== "string" || !new RegExp(`^${expectedIdPrefix}-[0-9A-F]{8}$`, "u").test(candidate),
    ) ||
    new Set(response.result.candidates).size !== response.result.candidates.length ||
    !isRecord(response.result.history) ||
    response.result.history.status !== "complete" ||
    typeof response.result.history.resolved_ref !== "string" ||
    response.result.history.resolved_ref.length === 0
  )
    fail("the sdd CLI returned an invalid project-aware ID result.");
}
if (operation === "proposal.validate" && response.status === "ok")
  verifyProposalPackage(response.result, response.project_id);
if (operation === "proposal.materialize" && response.status === "ok") {
  const bundle = optionValue(commandArguments, "--bundle");
  const mode = optionValue(commandArguments, "--mode");
  const expectedKeys =
    mode === "code"
      ? ["bundle_path", "package_path", "proposal"]
      : ["bundle_path", "candidate_path", "package_path", "proposal"];
  if (
    !hasExactKeys(response.result, expectedKeys) ||
    response.result.bundle_path !== bundle ||
    (mode !== "code" && response.result.candidate_path !== `${bundle}/candidate-tree.json`) ||
    response.result.package_path !== `${bundle}/proposal-package.json`
  )
    fail("the sdd CLI returned an invalid proposal materialization result.");
  verifyProposalPackage(response.result.proposal, response.project_id);
  if (response.result.proposal.candidate.source !== (mode === "code" ? "base" : "manifest"))
    fail("the proposal materialization package is not bound to its retained candidate.");
}
if (operation === "approval.record" && response.status === "ok") {
  if (
    !verifyApprovalRecordResult(response.result, response.project_id) ||
    response.result.evidence_path !== optionValue(commandArguments, "--evidence") ||
    response.result.decision !== optionValue(commandArguments, "--decision")
  )
    fail("the sdd CLI returned an invalid approval recording result.");
}
if (operation === "proposal.prepare") {
  if (response.status === "ok" || response.status === "review_required") {
    if (
      !isRecord(response.result) ||
      !verifyConflictReport(response.result.conflict_report, response.project_id) ||
      (response.status === "ok"
        ? !verifySpecPatch(response.result.spec_patch, response.project_id)
        : response.result.spec_patch !== null)
    )
      fail("the sdd CLI returned an invalid proposal preparation result.");
  } else if (response.status === "blocked" && response.result !== null) {
    if (
      !isRecord(response.result) ||
      !verifyConflictReport(response.result.conflict_report, response.project_id) ||
      response.result.spec_patch !== null
    )
      fail("the sdd CLI returned an invalid blocked proposal preparation result.");
  }
}
if (operation === "proposal.apply" && response.status === "ok") {
  if (
    !isRecord(response.result) ||
    !isFingerprint(response.result.result_tree_fingerprint) ||
    !Array.isArray(response.result.applied_paths) ||
    response.result.applied_paths.some((path) => !isProjectPath(path)) ||
    new Set(response.result.applied_paths).size !== response.result.applied_paths.length
  )
    fail("the sdd CLI returned an invalid proposal apply result.");
}
if (operation === "tests.discover" && response.status === "ok") {
  if (!verifyTestIndex(response.result, response.project_id)) fail("the sdd CLI returned an invalid TestIndex result.");
}
if (operation === "findings.validate" && (response.status === "ok" || response.status === "blocked")) {
  if (!verifyFindingAssessment(response.result)) fail("the sdd CLI returned an invalid finding assessment result.");
}
if (
  operation === "merge.check" &&
  (response.status === "ok" || response.status === "blocked" || response.status === "review_required")
) {
  if (!verifyMergeReport(response.result, response.project_id, response.status))
    fail("the sdd CLI returned an invalid MergeReport result.");
}

writeFileSync(1, execution.stdout);
writeFileSync(2, execution.stderr);
process.exit(execution.status);
