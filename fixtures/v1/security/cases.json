    "fixture_form": "Scenario definitions describe path-bearing artifact input, filesystem topology, and deterministic mutation hooks. A future platform test materializes the topology inside an isolated temporary project root.",
    "path_domain": "Paths are non-empty normalized project-relative UTF-8 paths using slash separators and must remain beneath the configured specification root.",
    "lexical_rejection": "Reject absolute, drive-relative, dot-segment, NUL-bearing, ambiguous-separator, and platform-reserved paths before filesystem mutation.",
    "component_topology_rejection": "Inspect every existing component from the project root to the target without following a symlink or junction outside project scope.",
    "case_collision_rejection": "On a case-insensitive filesystem, reject a target whose normalized spelling aliases a differently cased existing path.",
    "toctou_revalidation": "Revalidate path identity and patch preconditions after validation and before mutation; any change aborts the complete patch.",
    "jsonl_untrusted_data": "Parse each bounded UTF-8 line as data, reject invalid source paths and adapter-supplied Requirement mappings, and produce no partial TestIndex after rejection.",
    "xml_parser_mode": "Use a bounded non-networked XML parser with DTD processing and external entities disabled.",
    "xml_doctype_rejection": "Reject every XML document containing a DOCTYPE before processing internal declarations, resolving an entity, or importing any testcase.",
    "external_entity_side_effects": {
      "filesystem_reads": 0,
      "network_requests": 0,
      "imported_tests": 0
    },
    "command_invocation": "Preserve configured argv element boundaries, order, and literal UTF-8 text, then pass the executable and argument array to direct process spawning with shell evaluation disabled.",
    "shell_syntax_handling": "Shell metacharacters, substitutions, environment references, globs, redirections, separators, and whitespace inside an argv element remain literal adapter data. Configuration performs no interpolation and the CLI starts no shell.",
