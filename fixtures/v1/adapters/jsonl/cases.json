  "oracle_semantics": {
    "stream_encoding": "utf8-json-lines-with-one-json-object-per-line",
    "first_record": "test_stream-header",
    "discovery_records_after_header": [
      "suite",
      "test"
    ],
    "execution_records_after_header": [
      "result"
    ],
    "result_local_ids": "adapter-local IDs that correspond to the selected indexed test refs",
    "selection_binding": "project_id and test_index_fingerprint identify the exact TestIndex subject",
    "selection_ordering": "test_refs are unique and canonically sorted",
    "local_id_scope": "local_id is unique across suite and test records within one discovery stream",
    "parent_resolution": "parent_id may resolve to a suite declared before or after the child",
    "hierarchy": "parent links must resolve to suites and form an acyclic graph",
    "full_name": "join ancestor suite names from root to leaf and the test name with one ASCII space",
    "requirement_extraction": "scan full_name for standalone case-sensitive REQ-[0-9A-F]{8} IDs, then deduplicate and sort",
    "empty_suite_coverage": "a suite with no executable test descendants contributes no coverage",
    "known_requirement_context": [
      "REQ-12E19D70",
      "REQ-F7CEE6D0",
      "REQ-E451458E",
      "REQ-5A832396",
      "REQ-72BA737C"
    ],
    "normalized_node_order": "adapter_id then local_id, independent of input record order after the header",
    "blocking_adapter_failures": [
      "malformed-jsonl",
      "truncated-stream",
      "malformed-utf8",
      "timeout",
      "output-overflow",
      "nonzero-exit"
    ]
  },
