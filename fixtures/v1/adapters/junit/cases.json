{
  "fixture_manifest_version": "1.0",
  "status": "bootstrap-fixture-manifest",
  "fixture_family_id": "adapter-junit",
  "completed_leaves": [
    "0.6c"
  ],
  "scope": "Language- and framework-neutral JUnit-compatible XML import fixtures for hierarchy, deterministic derived identity, result and source mapping, malformed input, and bounded parser failures; importer implementation, CLI behavior, and the broader security corpus are deferred.",
  "contracts": [
    "adapter.junit-import",
    "artifact.test-index",
    "artifact.test-execution-evidence"
  ],
  "requirements": [
    "REQ-6D8DDDF7",
    "REQ-12E19D70"
  ],
  "authorities": [
    "proposal/spec/capabilities/test-traceability-and-qa.md#req-6d8dddf7",
    "proposal/spec/capabilities/test-traceability-and-qa.md#req-12e19d70",
    "proposal/architecture/test-adapters.md#junit-compatible-importer",
    "proposal/architecture/security.md#malicious-adapter-output",
    "proposal/architecture/security.md#denial-of-service"
  ],
  "oracle_semantics": {
    "input_encoding": "utf8-xml",
    "hierarchy": "preserve testsuite nesting and names exactly when present; report lost or ambiguous hierarchy and never reconstruct it from testcase.classname or another framework-specific guess",
    "executable_nodes": "each testcase maps to one executable normalized test",
    "result_mapping": {
      "failure": "failed",
      "error": "failed",
      "skipped": "skipped",
      "otherwise_completed": "passed"
    },
    "source_mapping": "retain project-relative testcase.file and positive integer testcase.line when present",
    "time_mapping": "retain testcase.time in seconds when present without assigning a Stage 0 runtime representation",
    "derived_id_components": [
      "report_path",
      "suite_path",
      "testcase_classname",
      "testcase_name",
      "occurrence_index"
    ],
    "derived_id_contract": "equal component tuples produce the same opaque local ID; a changed component tuple produces a distinct opaque local ID; the concrete encoding and hash algorithm remain deferred to runtime design",
    "xml_limits": [
      "max_report_bytes",
      "max_xml_depth",
      "max_suite_count",
      "max_test_count"
    ],
    "blocking_failures": [
      "malformed-xml",
      "dtd-or-external-entity",
      "report-bytes-overflow",
      "xml-depth-overflow",
      "suite-count-overflow",
      "test-count-overflow"
    ]
  },
  "cases": [
    {
