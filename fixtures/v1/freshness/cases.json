  "oracle_semantics": {
    "evaluation_gate": "merge",
    "outcome_values": [
      "PASS",
      "REVIEW_REQUIRED",
      "BLOCKED"
    ],
    "current": "A required artifact is schema-valid, has an allowed issuer where applicable, and is bound to the exact current project, refs, configuration, indexes, object inputs, mode, and affected subject.",
    "stale": "A schema-valid artifact whose bound subject differs from the current subject is rejected and yields BLOCKED; it is never silently reused.",
    "missing": "Missing applicable human-decision evidence yields REVIEW_REQUIRED when no definite violation exists. Missing deterministic or execution evidence is outside this leaf's human-decision matrix and remains a failed required check in the gate outcome oracle.",
    "negative": "An applicable rejected, failed, or confirmed human decision is a definite violation and yields BLOCKED.",
    "contradictory": "Conflicting applicable decisions for the same current subject yield BLOCKED.",
    "not_applicable": "Evidence not required by the selected mode, affected scope, adoption transition, or open Finding set does not affect the outcome.",
    "mode_conditions": {
      "spec-code": "Requires current approval for an approved non-empty semantic delta.",
      "spec": "Requires current approval for an approved non-empty semantic delta and current baseline QA.",
      "code": "Requires empty semantic and structural specification deltas and current target Requirement fingerprints."
    },
    "authentication_boundary": "The CLI validates configured issuer names and subject fingerprints. Actor authentication and organizational authorization remain external and are not inferred by this oracle.",
    "schema_fixture_boundary": "Cases assume artifacts already passed their JSON Schema. Unknown fields, malformed values, wrong projects, wrong artifact types, and missing schema fields remain in fixtures/v1/artifacts/cases.json."
  },
