{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "SDD Yo version 1 shared artifact definitions",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "artifactType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^SDD-[0-9A-F]{8}$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^REQ-[0-9A-F]{8}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitObjectId": {
      "type": "string",
      "minLength": 1
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifactEnvelope": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_type",
        "project_id"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "artifact_type": {
          "$ref": "#/$defs/artifactType"
        },
        "project_id": {
          "$ref": "#/$defs/projectId"
        },
        "created_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        }
      }
    },
    "approvedDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic",
        "structural"
      ],
      "properties": {
        "semantic": {
          "$ref": "#/$defs/fingerprint"
        },
        "structural": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "codeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "semantic_fingerprint",
        "structural_fingerprint"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/requirementId"
        },
        "semantic_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "structural_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    }
  }
}
