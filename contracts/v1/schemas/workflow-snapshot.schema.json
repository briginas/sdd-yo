{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-snapshot.schema.json",
  "title": "SDD Yo WorkflowSnapshot",
  "description": "Version 1 deterministic derived read-only workflow observation snapshot.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "spec-code"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "stages": {
            "minItems": 9,
            "maxItems": 9,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/stageSnapshot"
                },
                {
                  "properties": {
                    "stage_id": {
                      "$ref": "workflow-event.schema.json#/$defs/specCodeStageId"
                    }
                  }
                }
              ]
            }
          },
          "base_ref": {
            "type": "null"
          },
          "code_targets": {
            "maxItems": 0
          },
          "accepted_behavior": {
            "type": "null"
          },
          "intended_qa_plan": {
            "type": "null"
          },
          "implementation_state": {
            "type": "null"
          },
          "current_stage_id": {
            "anyOf": [
              {
                "$ref": "workflow-event.schema.json#/$defs/specCodeStageId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "mode": {
              "const": "code"
            }
          },
          "required": ["mode"]
        },
        "then": {
          "properties": {
            "stages": {
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/stageSnapshot"
                  },
                  {
                    "properties": {
                      "stage_id": {
                        "$ref": "workflow-event.schema.json#/$defs/codeStageId"
                      }
                    }
                  }
                ]
              }
            },
            "base_ref": {
              "$ref": "common.schema.json#/$defs/gitObjectId"
            },
            "code_targets": {
              "minItems": 1
            },
            "accepted_behavior": {
              "type": "null"
            },
            "intended_qa_plan": {
              "type": "null"
            },
            "implementation_state": {
              "type": "null"
            },
            "current_stage_id": {
              "anyOf": [
                {
                  "$ref": "workflow-event.schema.json#/$defs/codeStageId"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "else": {
          "if": {
            "properties": {
              "mode": {
                "const": "spec"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "stages": {
                "minItems": 8,
                "maxItems": 8,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/stageSnapshot"
                    },
                    {
                      "properties": {
                        "stage_id": {
                          "$ref": "workflow-event.schema.json#/$defs/specStageId"
                        }
                      }
                    }
                  ]
                }
              },
              "base_ref": {
                "type": "null"
              },
              "code_targets": {
                "maxItems": 0
              },
              "accepted_behavior": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "intended_qa_plan": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "implementation_state": {
                "const": "not_applicable"
              },
              "current_stage_id": {
                "anyOf": [
                  {
                    "$ref": "workflow-event.schema.json#/$defs/specStageId"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "stages": {
                "maxItems": 0
              },
              "base_ref": {
                "type": "null"
              },
              "code_targets": {
                "maxItems": 0
              },
              "accepted_behavior": {
                "type": "null"
              },
              "intended_qa_plan": {
                "type": "null"
              },
              "implementation_state": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "artifact_type",
    "project_id",
    "change_id",
    "run_id",
    "producer_id",
    "mode",
    "base_ref",
    "code_targets",
    "accepted_behavior",
    "intended_qa_plan",
    "implementation_state",
    "observation_start",
    "last_sequence",
    "execution",
    "current_step_id",
    "current_stage_id",
    "cli_status",
    "merge_readiness",
    "artifact_freshness",
    "approval_state",
    "integration_state",
    "interruption_reason",
    "observer_diagnostic",
    "steps",
    "stages",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "artifact_type": {
      "const": "workflow_snapshot"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/projectId"
    },
    "change_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "producer_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "mode": {
      "anyOf": [
        {
          "enum": ["spec-code", "spec", "code"]
        },
        {
          "type": "null"
        }
      ]
    },
    "base_ref": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/gitObjectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "code_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/codeTarget"
      },
      "x-sdd-ordering": "requirement_id"
    },
    "accepted_behavior": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "intended_qa_plan": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "implementation_state": {
      "anyOf": [
        {
          "const": "not_applicable"
        },
        {
          "type": "null"
        }
      ]
    },
    "observation_start": {
      "anyOf": [
        {
          "enum": ["complete", "partial"]
        },
        {
          "type": "null"
        }
      ]
    },
    "last_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "execution": {
      "enum": ["active", "waiting", "interrupted", "failed", "completed"]
    },
    "current_step_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_stage_id": {
      "anyOf": [
        {
          "$ref": "workflow-event.schema.json#/$defs/workflowStageId"
        },
        {
          "type": "null"
        }
      ]
    },
    "cli_status": {
      "anyOf": [
        {
          "$ref": "workflow-event.schema.json#/$defs/cliStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "merge_readiness": {
      "anyOf": [
        {
          "$ref": "workflow-event.schema.json#/$defs/readinessState"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_freshness": {
      "anyOf": [
        {
          "$ref": "workflow-event.schema.json#/$defs/freshnessState"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_state": {
      "$ref": "workflow-event.schema.json#/$defs/approvalState"
    },
    "integration_state": {
      "$ref": "workflow-event.schema.json#/$defs/integrationState"
    },
    "interruption_reason": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "observer_diagnostic": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^SDD_[A-Z0-9_]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stepSnapshot"
      },
      "x-sdd-ordering": "first-observed"
    },
    "stages": {
      "type": "array",
      "minItems": 0,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/stageSnapshot"
      },
      "x-sdd-ordering": "stable-stage-model"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "workflow-event.schema.json#/$defs/artifactReference"
      },
      "uniqueItems": true,
      "x-sdd-ordering": "first-observed"
    }
  },
  "$defs": {
    "stageSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "label", "state", "reason"],
      "properties": {
        "stage_id": {
          "$ref": "workflow-event.schema.json#/$defs/workflowStageId"
        },
        "label": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "state": {
          "$ref": "workflow-event.schema.json#/$defs/workflowStageState"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "stepSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "label", "state", "waiting_reason", "diagnostic_code"],
      "properties": {
        "step_id": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "label": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "state": {
          "enum": ["active", "waiting", "failed", "completed"]
        },
        "waiting_reason": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^SDD_[A-Z0-9_]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
