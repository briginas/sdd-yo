{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding-resolution.schema.json",
  "title": "SDD Yo FindingResolution",
  "description": "Version 1 external human decision for one exact Finding input.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "issuer",
    "actor",
    "finding_id",
    "input_fingerprint",
    "decision",
    "reason"
  ],
  "properties": {
    "artifact_type": {
      "const": "finding_resolution"
    },
    "issuer": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "finding_id": {
      "$ref": "common.schema.json#/$defs/findingId"
    },
    "input_fingerprint": {
      "$ref": "common.schema.json#/$defs/fingerprint"
    },
    "decision": {
      "enum": [
        "dismissed",
        "waived",
        "confirmed"
      ]
    },
    "reason": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    }
  },
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/artifactEnvelope"
    }
  ]
}
