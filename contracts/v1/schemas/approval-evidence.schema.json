{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approval-evidence.schema.json",
  "title": "SDD Yo ApprovalEvidence",
  "description": "Version 1 external product approval decision.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "issuer",
    "actor",
    "decision",
    "mode",
    "subject"
  ],
  "properties": {
    "artifact_type": {
      "const": "approval_evidence"
    },
    "issuer": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "mode": {
      "$ref": "common.schema.json#/$defs/mode"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "candidate",
        "object_delta",
        "code_targets",
        "affected_scope"
      ],
      "properties": {
        "base": {
          "$ref": "proposal-package.schema.json#/properties/base"
        },
        "candidate": {
          "$ref": "proposal-package.schema.json#/properties/candidate"
        },
        "object_delta": {
          "$ref": "proposal-package.schema.json#/properties/object_delta"
        },
        "code_targets": {
          "$ref": "proposal-package.schema.json#/properties/code_targets"
        },
        "affected_scope": {
          "$ref": "proposal-package.schema.json#/properties/affected_scope"
        }
      }
    },
    "reason": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    }
  },
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/artifactEnvelope"
    }
  ]
}
